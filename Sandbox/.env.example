# n8n Sandbox Service — Environment Template (.env.example)
# Generate secrets using: openssl rand -hex 32

SANDBOX_API_KEYS=YOUR_FIRST_SECRET
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=YOUR_SECOND_SECRET
SANDBOX_API_RUNNER_API_KEY=YOUR_THIRD_SECRET
SANDBOX_RUNNER_API_KEYS=YOUR_THIRD_SECRET
SANDBOX_RUNNER_REGISTRATION_TOKEN=YOUR_SECOND_SECRET
